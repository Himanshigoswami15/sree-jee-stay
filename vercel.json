{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://jj-review-system.onrender.com/api/:path*" },
    { "source": "/r/:path*", "destination": "https://jj-review-system.onrender.com/r/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
