{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sree-jee-stay.onrender.com/api/:path*" },
    { "source": "/r/:path*", "destination": "https://sree-jee-stay.onrender.com/r/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
