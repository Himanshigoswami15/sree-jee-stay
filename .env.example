# Google Place ID for Google Business Profile Direct Review link
# Format: https://search.google.com/local/writereview?placeid={VITE_GOOGLE_PLACE_ID}
VITE_GOOGLE_PLACE_ID=YOUR_GOOGLE_PLACE_ID_HERE

# MongoDB Atlas Cloud Database
# Get your connection string from https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/jj_review_system?retryWrites=true&w=majority&appName=JJReviewSystem

# Application Environment
NODE_ENV=development
CLIENT_URL=http://localhost:7890

# JWT Authentication Configuration
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server Configuration
PORT=8080
LOG_LEVEL=info

# Super Admin Authorization Secret Key
ADMIN_SECRET_KEY=JJR-2026-SUPER-6X8F91ZP-K29A
