# Google Place ID for Google Business Profile Direct Review link
# Format: https://search.google.com/local/writereview?placeid={VITE_GOOGLE_PLACE_ID}
VITE_GOOGLE_PLACE_ID=YOUR_GOOGLE_PLACE_ID_HERE

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/sree_jee_stay

# JWT Authentication Configuration
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server Configuration
PORT=8080
LOG_LEVEL=info
